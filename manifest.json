{
  "manifest_version": 3,
  "name": "upeg-hunter",
  "version": "2.0.0",
  "description": "Star traits and show OpenRarity/MineRarity ranks on myupeg.art, with opt-in auto-draw.",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://server.unipeg.art/*",
    "https://unipeg-lens.sonys-chan.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://myupeg.art/*", "https://*.myupeg.art/*"],
      "js": ["myupeg.js"],
      "css": ["myupeg.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "upeg-hunter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
